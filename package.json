{
  "name": "ssafy-net",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*",
    "api",
    "web"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "npm run build --workspace=@ssafy-net/shared && npm run build --workspace=api && npm run build --workspace=web",
    "prisma:migrate": "npm run prisma:migrate --workspace=api",
    "prisma:seed": "npm run prisma:seed --workspace=api",
    "prisma:studio": "npm run prisma:studio --workspace=api",
    "seed:dev": "npm run seed:dev --workspace=api",
    "content:import": "npm run content:import --workspace=api --"
  },
  "engines": {
    "node": ">=22"
  }
}
