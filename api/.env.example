# 개발 환경 변수 예시. 실제 값은 api/.env 에 둔다(.gitignore 대상).

DATABASE_URL="postgresql://ssafynet:ssafynet@localhost:5432/ssafynet?schema=public"

# 세션 쿠키 JWT 서명 키. 운영에서는 반드시 새로 만든다.
SESSION_SECRET="dev-only-change-me"

# Google OAuth (docs/16 D-56 — 로그인은 Google만)
# https://console.cloud.google.com/auth/clients 에서 웹 클라이언트를 만들고
# 승인된 리디렉션 URI에 GOOGLE_CALLBACK_URL 값을 등록한다.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# 알림 링크 생성과 OAuth 복귀에 쓰는 프론트 주소
APP_BASE_URL="http://localhost:5173"

PORT=3000
TZ=Asia/Seoul

# Mattermost — 온보딩 인증(D-66)과 알림(D-67). README "Mattermost 설정" 참조.
# MATTERMOST_WEBHOOK_URL 이 비어 있으면 채널이 꺼진다(인증 코드도 나가지 않는다).
MATTERMOST_URL="https://meeting.ssafy.com"
MATTERMOST_WEBHOOK_URL=""
# 웹훅을 만든 계정의 아이디. 이 계정만 DM을 받을 수 없어 인증을 우회한다.
MATTERMOST_OPERATOR_USERNAME=""
# 발송 모드. 기본값 redirect 가 안전장치다 — 모든 DM이 운영자 채널로만 간다.
# 공개할 때만 live 로 바꾼다.
MATTERMOST_DELIVERY_MODE="redirect"
# live 모드에서도 여기 적힌 아이디(쉼표 구분)에게만 보낸다. 비어 있으면 제한 없음.
# 소수 인원으로 시험할 때 쓴다.
MATTERMOST_ALLOWED_RECIPIENTS=""
