# 개발 환경 변수 예시. 실제 값은 api/.env 에 둔다(.gitignore 대상).

DATABASE_URL="postgresql://ssafynet:ssafynet@localhost:5432/ssafynet?schema=public"

# 세션 쿠키 JWT 서명 키. 운영에서는 반드시 새로 만든다.
SESSION_SECRET="dev-only-change-me"

# Google OAuth (docs/16 D-56 — 로그인은 Google만)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/api/auth/google/callback"

# 알림 링크 생성과 OAuth 복귀에 쓰는 프론트 주소
APP_BASE_URL="http://localhost:5173"

PORT=3000
TZ=Asia/Seoul

# 이메일 (docs/18 B-3 확인 후). 비어 있으면 이메일 채널은 꺼진다.
SMTP_URL=""
MAIL_FROM="Interest Network <noreply@example.com>"

# Web Push (M4에서 사용). 비어 있으면 브라우저 알림 채널은 꺼진다.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:noreply@example.com"
