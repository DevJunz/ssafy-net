# 운영 환경 변수. 복사해서 deploy/.env 로 두고 채운다. deploy/.env 는 git 에 들어가지 않는다.
# docker compose -f deploy/docker-compose.prod.yml ... 이 이 파일을 읽는다.
# 값에 따옴표를 쓰지 않는다.

# ── 서버 ──────────────────────────────────────────────────────────────
# Caddy 사이트 주소. 도메인을 적으면 Let's Encrypt 인증서를 자동으로 받는다(80·443 이 열려 있어야 한다).
# 도메인 없이 잠깐 확인만 할 때는 :80 (TLS 없음. 쿠키가 secure 라 로그인은 안 된다).
SITE_ADDRESS=connect.example.com
# 프론트 주소. 알림 링크·OAuth 복귀·CORS 에 쓴다. https://<SITE_ADDRESS>
APP_BASE_URL=https://connect.example.com

# ── DB ────────────────────────────────────────────────────────────────
# 영문·숫자만(접속 URL 에 그대로 들어간다). 만들기: openssl rand -hex 16
POSTGRES_PASSWORD=

# ── 세션 ──────────────────────────────────────────────────────────────
# 쿠키 JWT 서명 키. 개발용 값을 쓰지 않는다. 만들기: openssl rand -hex 32
SESSION_SECRET=

# ── Google OAuth (README "Google OAuth 설정") ─────────────────────────
# 승인된 리디렉션 URI 에 GOOGLE_CALLBACK_URL 값을 등록한다.
# 클라이언트는 어느 Google 계정의 프로젝트에 있어도 된다. 서버를 띄운 GCP 계정과 같을 필요가 없다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://connect.example.com/api/auth/google/callback

# ── Mattermost (README "Mattermost 설정") ─────────────────────────────
MATTERMOST_URL=https://meeting.ssafy.com
MATTERMOST_WEBHOOK_URL=
MATTERMOST_OPERATOR_USERNAME=
# 기본값 redirect 가 안전장치다. 모든 DM 이 운영자 채널로만 간다. 공개하는 날에만 live.
MATTERMOST_DELIVERY_MODE=redirect
# live 에서도 여기 적힌 아이디(쉼표 구분)에게만 보낸다. 소수 인원 시험용. 비우면 제한 없음.
MATTERMOST_ALLOWED_RECIPIENTS=

# ── 백업 (deploy/backup.sh) ───────────────────────────────────────────
# 비우면 VM 안 deploy/backups/ 에만 남긴다. 버킷 이름을 적으면 gs://<bucket>/ 에도 올린다.
BACKUP_BUCKET=
